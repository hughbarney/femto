#!./run
# test executable and dired functionality
# Created By Hugh Barney 24 August 2025

export FLISPRC=../lisp/core.lsp

# The tap value should be set to the number of tests in the file
tap 5

# define sub functions to be used in this test file
diredlib() { IN="(require 'string) (require 'dired) $IN" flisp_expr "$@"; }

# test 1
IN='(de-up-dir "/home/hugh")' OUT='"/home"'
diredlib 1; ok de-up-dir-1 moves up 1 subdir

# test 2, check that de-up-dir returns / when there is only 1 character in the path
IN='(de-up-dir "/")' OUT='"/"'
diredlib 1; ok de-up-dir-2 1 char path returns root


# de-drop-fields: the name is everything after the 8 `ls -la` fields
IN="(de-drop-fields \"  drwxr-xr-x@  3 rick  staff   96 Nov  1 08:26 Mobile Documents\" 8)" OUT='"Mobile Documents"'
diredlib 1; ok de-drop-fields-1 name with spaces

IN="(de-drop-fields \"  lrwxr-xr-x   1 rick  staff   24 Dec 17  2024 docs -> /Users/rick/Mobile Documents\" 8)" OUT='"docs -> /Users/rick/Mobile Documents"'
diredlib 1; ok de-drop-fields-2 symlink keeps its target

IN="(de-shell-quote \"/tmp/rick's dir\")" OUT="\"'/tmp/rick'\\\\''s dir'\""
diredlib 1; ok de-shell-quote-1 embedded single quote is escaped
